# Copy to integrations/fetch/.env (gitignored) and fill in. This file is read
# by both the planner service (Node) and the uAgent (Python). It is separate
# from the web app's root .env on purpose.

# --- Shared between the uAgent and the planner service -----------------------
# Bearer token the uAgent uses to call the planner service. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ROOMWISE_PLANNER_API_KEY=

# --- Planner service (Node, `pnpm start`) ------------------------------------
ROOMWISE_PLANNER_HOST=127.0.0.1
ROOMWISE_PLANNER_PORT=8787
# Required for live product search (Google Shopping via the existing Apify client).
APIFY_TOKEN=
# Natural-language interpreter: auto (default) | asi1 | claude | keyword.
# auto uses ASI:One if ASI1_API_KEY is set, else Claude if ANTHROPIC_API_KEY
# is set, else the deterministic keyword parser.
ROOMWISE_LLM_PROVIDER=auto
# ASI:One LLM (OpenAI-compatible API). Key from https://asi1.ai/developer
ASI1_API_KEY=
ASI1_MODEL=asi1
# Optional alternative: Claude.
ANTHROPIC_API_KEY=
ROOMWISE_LLM_MODEL=claude-opus-5-5
# Idle minutes before a conversation's state is discarded.
ROOMWISE_SESSION_TTL_MINUTES=120
ROOMWISE_MAX_SESSIONS=1000
ROOMWISE_SEARCH_TIMEOUT_SECONDS=90

# --- Agent team (Python, `python agent.py`) -----------------------------------
# Private seed phrases: each determines one agent's address and signing key.
# Every agent needs its own, unique seed. Never commit them. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_SEED=
DESIGN_AGENT_SEED=
PRODUCT_AGENT_SEED=
BUDGET_AGENT_SEED=
COMPARISON_AGENT_SEED=
QUOTATION_AGENT_SEED=
FINANCE_AGENT_SEED=
# Orchestrator's name (specialists are roomwise-<role>-agent).
AGENT_NAME=roomwise-orchestrator
# All seven agents share this port (one Bureau process).
AGENT_PORT=8001
# true = receive ASI:One messages through Agentverse mailboxes.
AGENT_MAILBOX=true
ROOMWISE_PLANNER_URL=http://127.0.0.1:8787
ROOMWISE_PLANNER_TIMEOUT_SECONDS=240
