# Copy this file to .env and fill in real values. .env is gitignored.

# Apify — https://console.apify.com/account/integrations
APIFY_TOKEN=

# Visa Acceptance Solutions (CyberSource) merchant sandbox
# https://developer.cybersource.com — HTTP Signature auth via the official
# cybersource-rest-client SDK. Sandbox host is apitest.cybersource.com.
VISA_RUN_ENVIRONMENT=apitest.cybersource.com
VISA_MERCHANT_ID=
VISA_KEY_ID=
VISA_SHARED_SECRET=
