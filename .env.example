# Copy this file to .env and fill in real values. .env is gitignored.

# Apify — https://console.apify.com/account/integrations
# Also powers real image generation for custom "Generate with AI" library
# items (server/apifyClient.ts generateProductImage, ~$0.001/image).
APIFY_TOKEN=

# Anthropic — https://console.anthropic.com/settings/keys
# Powers the tool-calling chat agent (state/RoomwiseContext.tsx runCommand).
# Without this, the chat falls back to a simpler keyword-based command parser.
ANTHROPIC_API_KEY=

# Visa Acceptance Solutions (CyberSource) merchant sandbox
# https://developer.cybersource.com — HTTP Signature auth via the official
# cybersource-rest-client SDK. Sandbox host is apitest.cybersource.com.
VISA_RUN_ENVIRONMENT=apitest.cybersource.com
VISA_MERCHANT_ID=
VISA_KEY_ID=
VISA_SHARED_SECRET=
